# π0.5 (pi05) 学習用のイメージ。solution/train/Dockerfile（SmolVLA 用）の変種で、
# 差分は extras（`smolvla,peft` → `pi`）と COPY するスクリプトだけである。
#
#   docker build -t parc2026-train-pi05 -f solution/train/Dockerfile.pi05 solution/train
#   docker run --gpus all --rm -it \
#       --user "$(id -u):$(id -g)" \
#       -v "$PWD/work/train:/out" -v "$HOME/.cache/huggingface:/hf_home" \
#       parc2026-train-pi05
#
# **`--user` を付けて非rootで動かす前提。** マウント先を `/root/.cache/huggingface`
# ではなく `/hf_home` にしてあるのはそのため —— `/root` 自体が `drwx------`
# （root 所有）なので、`--user` で非root にした瞬間、中身の権限が正しくても
# `/root` を跨げず全滅する（2026-08-13 に実機で確認済みの失敗）。`/` 直下の
# `/hf_home` なら、マウント元（`$HOME/.cache/huggingface`）の所有者と
# `--user` の数値が一致してさえいれば通る。
#
# **学習前に、ホスト側で一度だけ `hf auth login` が要る**
# （`$HOME/.cache/huggingface` をマウントしているので、ログイン済みならこのまま使える）。
# π0.5 は Hugging Face の gemma ライセンスで配布されており、
# https://huggingface.co/google/paligemma-3b-pt-224 の利用規約に同意した
# アカウントでログインしていないと初期重みの取得で止まる。
# 詳しくは train_pi05.py の docstring を読むこと。
#
# CUDA・torch・torchcodec・torchvision の版の対については
# solution/train/Dockerfile の注記をそのまま参照（このファイルでは省略しない）。
FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV HF_HOME=/hf_home

# **`--user` で動かすと /etc/passwd に UID のエントリが無い。**
# torch の内部（`_inductor/runtime/cache_dir_utils.py`）がキャッシュ置き場を
# 決めるのに `getpass.getuser()` を呼び、それが `pwd.getpwuid(os.getuid())`
# へ落ちて `KeyError` になる（2026-08-13 に実機で確認済みの失敗）。
# `getpass.getuser()` は `USER`/`LOGNAME` 環境変数があればそちらを先に見るので、
# 中身が何であっても構わず設定しておく。`HOME` も `/root`（前述の理由で
# 非rootから書けない）ではなく、誰の UID でも書き込める `/tmp` にする。
ENV HOME=/tmp
ENV USER=trainer
ENV LOGNAME=trainer
# `/tmp/torchinductor_trainer`（torch.compile のキャッシュ置き場）の権限修正は
# ここではなく、下の「ここから下は変更が起きやすい層」の節にある
# （2026-08-22。理由は書き込む git ログ・そちらの節を参照。ここに直置きすると
# 下の重いレイヤー全部のキャッシュを毎回無効にしてしまう）。

ARG TORCH_INDEX=https://download.pytorch.org/whl/cu128
ARG TORCH_VERSION=2.11.0
ARG TORCHCODEC_VERSION=0.11.1
ARG TORCHVISION_VERSION=0.26.0

RUN apt-get update && apt-get install -y --no-install-recommends \
        git build-essential ca-certificates ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir "torch==${TORCH_VERSION}" --index-url ${TORCH_INDEX}
RUN pip install --no-cache-dir "torchcodec==${TORCHCODEC_VERSION}" --index-url ${TORCH_INDEX}

RUN pip install --no-cache-dir "nvidia-npp-cu12" \
    && NPP_SO="$(find /usr/local/lib/python3.12/site-packages/nvidia \
            -name 'libnppicc.so*' -print -quit)" \
    && test -n "$NPP_SO" \
    && dirname "$NPP_SO" > /etc/ld.so.conf.d/nvidia-npp.conf \
    && ldconfig \
    && ldconfig -p | grep -q libnppicc.so.12

RUN pip install --no-cache-dir "torchvision==${TORCHVISION_VERSION}" --index-url ${TORCH_INDEX}

# **ここだけが Dockerfile 本体との違い。** `smolvla,peft` の代わりに `pi`
# （π0/π0.5 が要る依存一式。openpi 由来のパッケージを含む）を入れる。
ARG LEROBOT_TAG=v0.6.0
RUN git clone --quiet --depth 1 --branch ${LEROBOT_TAG} \
        https://github.com/huggingface/lerobot.git /opt/lerobot \
    && pip install --no-cache-dir -e "/opt/lerobot[training,pi]"

# ============================================================================
# ここから下は変更・追加が起きやすい層（量子化ライブラリ・その場しのぎでない
# 恒久対応・RunPod 追い足し・COPY するスクリプト）。
#
# **触るならなるべくここから下に留めること。** 上の apt-get・torch/torchcodec/
# torchvision のインストール・lerobot の git clone は重く時間がかかる
# （ネットワーク次第で 15〜30 分規模）。docker のレイヤーキャッシュは
# 「最初に変わった行より後ろ全部」を無効にする方式なので、この境界より上を
# 直すと下のすべてが毎回作り直しになる。逆にこの境界より下だけを直す分には、
# 上のレイヤーはキャッシュがそのまま効く。
#
# 2026-08-22、torchinductor の権限修正（chmod 1777）を誤ってこの境界の
# はるか上（ENV HOME/USER/LOGNAME の直後）に置いてしまい、その1行のためだけに
# 全レイヤーが作り直しになった（ビルドし直し自体はやり切ったが、避けられた
# 待ち時間だった）。以後はこの境界を守ること。
# ============================================================================

# **torch.compile（inductor）のキャッシュ置き場の権限修正。** `USER=trainer`
# （上の ENV）から `/tmp/torchinductor_trainer` という名前でキャッシュ置き場を
# 決める。このディレクトリは(何が作ったにせよ)一度でも別の uid（典型的には
# `docker exec` を `-u root` で叩いたときなど）で作られると、既定の `755` の
# ままでは他の uid が中に書き込めず `PermissionError` で `--policy.compile_model=true`
# が丸ごと落ちる（`/tmp` 自体は `drwxrwxrwt` だが、その中の個々のディレクトリは
# 誰が作ったかの権限をそのまま引き継ぐため）。**ビルド時に `/tmp` 自身と同じ
# `1777`（sticky + 全員書き込み可）で先に作っておけば、誰が後から触っても
# 同じ問題が起きない。**
RUN mkdir -p /tmp/torchinductor_trainer && chmod 1777 /tmp/torchinductor_trainer

# **量子化スイープ用の追加ライブラリ（work/quant_sweep/PROGRESS.md 参照）。**
# 以前ここにあった `pip uninstall -y -q torchao` は、2026-08-20 に調べた結果
# 「現在の [training,pi] 一式は torchao を一切引っ張ってきておらず、
# 無効化の対象が最初から存在しない」空振りの安全策だったと判明した
# （理由の記載が無いまま fc976bd から存在。torchao を使うこと自体への実害は無い）。
#
# - bitsandbytes は torch/torchcodec と違い libtorch の ABI にリンクしない
#   （CUDA 11.8〜13.0 まとめて1 wheel、実行時に torch.version.cuda を見て選ぶ）ので
#   --index-url は不要。
# - torchao は最新 0.18.0 が torch 2.12（nightly）向けのビルドで、この
#   torch==2.11.0+cu128 に対しては 0.17.0 が対応版
#   （github.com/pytorch/ao/issues/2919 の対応表、2026-08-20 確認）。
RUN pip install --no-cache-dir "bitsandbytes==0.49.2" \
    && pip install --no-cache-dir "torchao==0.17.0" --index-url ${TORCH_INDEX}

RUN python -c "\
import torch, torchcodec, torchvision; \
from torchcodec.decoders import VideoDecoder; \
torchvision.ops.nms; \
print(f'torch {torch.__version__} / torchcodec {torchcodec.__version__} '\
      f'/ torchvision {torchvision.__version__} 整合')"

# bitsandbytes/torchao は import できることしか確認できない。CUDA カーネルが
# 実際に動く（8bit optimizer の step・4bit 量子化・float8 変換）かは GPU が
# 要るため、本当の確認は GPU 機での smoke test で行う
# （work/quant_sweep/CANDIDATES.md 参照）。
RUN python -c "\
import bitsandbytes, torchao; \
print(f'bitsandbytes {bitsandbytes.__version__} / torchao {torchao.__version__} import OK'\
      '（GPU 実行時の確認は別途）')"

# **RunPod で使うための追い足し（ローカル実行には影響しない）。**
# 1. openssh-server: RunPod の「Basic SSH」は RunPod のサーバを経由する簡易接続で
#    scp/sftp に対応しない。11GB 級のチェックポイントを持ち帰るには公開 IP +
#    Pod 内の sshd による「Full SSH」が必要で、公式テンプレートには最初から
#    入っているが**カスタムイメージには自分で入れないと使えない**
#    （https://docs.runpod.io/pods/configuration/use-ssh 2026-08-13 確認）。
#    起動は runpod_ssh_start.sh が行う。
# 2. openssh-sftp-server: **`--no-install-recommends` を付けているので明示が要る。**
#    OpenSSH 9 以降の `scp` は既定で SFTP プロトコルを使うため、これが無いと
#    サーバ側で `subsystem request failed` になり、`scp -O`（旧方式）でしか
#    転送できなくなる。持ち帰りが scp 前提なので入れておく。
# 3. tmux: 10 時間規模の学習を、接続が切れても生き残る形で回すため。
# 4. ホスト鍵は消す: apt の postinst がビルド時に作ってしまうため、そのままだと
#    このイメージを使う全 Pod が同一のホスト鍵を持つことになる。Pod ごとに
#    起動時に `ssh-keygen -A` で作り直す（runpod_ssh_start.sh）。
# 5. root への公開鍵ログインを明示的に許可する。Debian の既定
#    （`prohibit-password`）でも鍵認証は通るが、既定値に依存しないでおく。
# pip のレイヤより後ろに置いてあるのは、ここを直してもビルドし直しが安いようにするため。
RUN apt-get update && apt-get install -y --no-install-recommends \
        openssh-server openssh-sftp-server tmux \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/ssh/ssh_host_* \
    && mkdir -p /etc/ssh/sshd_config.d \
    && printf 'PermitRootLogin prohibit-password\nPasswordAuthentication no\n' \
        > /etc/ssh/sshd_config.d/runpod.conf
EXPOSE 22

WORKDIR /opt/pi05
# **スクリプトは /workspace ではなく /opt/pi05 に置く。** RunPod で Volume Disk /
# Network Volume を使うと、その永続ストレージは /workspace に上書きでマウント
# される（docs/howto/06_runpod_pi05.md）。/workspace にスクリプトを COPY すると、
# マウント方式によっては見えなくなる可能性があるため、影響を受けない場所に置く。
#
# train_pi05.py は同じディレクトリの train.py から選択ロジックを import するため、
# 両方を COPY する。prune_checkpoints.sh も学習と並行して使う。merge.py は
# 要らない —— pi05 は LoRA を使わず、train_expert_only のフルパラメータ学習
# なのでチェックポイントがそのまま提出用になる。
# runpod_ssh_start.sh は RunPod の Container Start Command から呼ぶ（上記参照）。
#
# experiments/quantization/ は量子化実験の候補 C1〜C3（work/quant_sweep/CANDIDATES.md
# 参照）と、train_pi05.py 側の窓口（__init__.py）。**train_pi05.py が
# `from experiments import quantization` で読むので、リポジトリと同じ並びのまま置く。**
# 中の lerobot_train_with_quant.py は、候補を lerobot-train の実行前に import する
# ための薄いラッパーで、`python /opt/pi05/experiments/quantization/…` として起動される。
#
# **`solution/tools/quant/dequantize_bnb4bit_checkpoint.py`（C2 のチェックポイントを評価用に
# bf16 へ戻す道具）はここには COPY しない。** ビルドコンテキストが `solution/train`
# なので `../tools/` は参照できない（コンテキスト外）。使うときは
# `docker exec -i quant_train bash -c 'cat > /tmp/dequantize_bnb4bit_checkpoint.py'`
# のように都度渡す（2026-08-22、実際にこの方法で C2 の再評価用チェックポイントを
# 作った。work/quant_sweep/PROGRESS.md 参照）。
COPY train.py train_pi05.py prune_checkpoints.sh runpod_ssh_start.sh /opt/pi05/
COPY experiments /opt/pi05/experiments/

VOLUME ["/out"]
ENV OUTPUT_ROOT=/out

CMD ["python", "/opt/pi05/train_pi05.py", "--smoke-test"]
